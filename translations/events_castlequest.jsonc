[
    {
        "en_raw": "Y'know... The end of the world is fine and all... But I only have one regret...",
        "en_clean": "Y'know... The end of the world is fine and all... But I only have one regret...",
        "jp_raw": "なんていうか... 世界が終わったって構わないんだが... 未練がひとつだけあって...",
        "jp_clean": "なんていうか... 世界が終わったって構わないんだが... 未練がひとつだけあって...",
        "checked": true
    },
    {
        "en_raw": "I......",
        "en_clean": "I......",
        "jp_raw": "俺は...",
        "jp_clean": "俺は...",
        "checked": true
    },
    {
        "en_raw": "<span class=\"big shake\">\n I WON'T BE ABLE TO KNOW WHAT HAPPENS\n <br/>\n TO LORD JOSÉPHANDRE IN THE FINAL ISSUE OF \"THE CURSING OF CHÂTEAU CASTLE\"!\n</span>",
        "en_clean": "I WON'T BE ABLE TO KNOW WHAT HAPPENS TO LORD JOSÉPHANDRE IN THE FINAL ISSUE OF \"THE CURSING OF CHÂTEAU CASTLE\"!",
        "jp_raw": "<span class=\"big shake\">\nけして知ることはできないんだ。\n <br/>\nジョゼファンドル卿と「キャッスル城の呪い」の結末をな！\n</span>",
        "jp_clean": "けして知ることはできないんだ。ジョゼファンドル卿と「キャッスル城の呪い」の結末をな！",
        "checked": true
    },
    {
        "en_raw": "Did he manage to protect his castle to the very end?!? Did he finally find his friend Pierre-Jacques-Erneste, did he finally find more about himself?!?",
        "en_clean": "Did he manage to protect his castle to the very end?!? Did he finally find his friend Pierre-Jacques-Erneste, did he finally find more about himself?!?",
        "jp_raw": "卿は城を守ることができるのか！？ 友人のピエール=ジャック=エルネストを見つけだし、自分の出自を知ることができるのか！？",
        "jp_clean": "卿は城を守ることができるのか！？ 友人のピエール=ジャック=エルネストを見つけだし、自分の出自を知ることができるのか！？",
        "checked": true
    },
    {
        "en_raw": "Oh... I'll never know...",
        "en_clean": "Oh... I'll never know...",
        "jp_raw": "ああ... 俺が知ることはないんだ...",
        "jp_clean": "ああ... 俺が知ることはないんだ...",
        "checked": true
    },
    {
        "en_raw": "(Is that really what they're worrying about today...? A book series? Not their imminent death or anything?)",
        "en_clean": "(Is that really what they're worrying about today...? A book series? Not their imminent death or anything?)",
        "jp_raw": "(今日みたいな日に心配することがソレ...？ シリーズ本の結末だって？ 差し迫った死じゃなく？)",
        "jp_clean": "(今日みたいな日に心配することがソレ...？ シリーズ本の結末だって？ 差し迫った死じゃなく？)",
        "checked": true
    },
    {
        "en_raw": "(Weird.)",
        "en_clean": "(Weird.)",
        "jp_raw": "(変なの。)",
        "jp_clean": "(変なの。)",
        "checked": true
    },
    {
        "en_raw": "(You didn't really care about their problem before, but...)",
        "en_clean": "(You didn't really care about their problem before, but...)",
        "jp_raw": "(前は彼の言っていることなど、どうでもよかったけれど...)",
        "jp_clean": "(前は彼の言っていることなど、どうでもよかったけれど...)",
        "checked": true
    },
    {
        "en_raw": "(\"The Cursing of Château Castle\", is it? Interesting...)",
        "en_clean": "(\"The Cursing of Château Castle\", is it? Interesting...)",
        "jp_raw": "(「キャッスル城の呪い」だっけ？ おもしろそう...)",
        "jp_clean": "(「キャッスル城の呪い」だっけ？ おもしろそう...)",
        "checked": true
    },
    {
        "en_raw": "(Maybe you could find the last issue for them?)",
        "en_clean": "(Maybe you could find the last issue for them?)",
        "jp_raw": "(最終巻を見つけてあげるのもいいかも。)",
        "jp_clean": "(最終巻を見つけてあげるのもいいかも。)",
        "checked": true
    },
    {
        "en_raw": "\"There's this book fan...\"",
        "en_clean": "\"There's this book fan...\"",
        "jp_raw": "\"本のファンがいて...\"",
        "jp_clean": "\"本のファンがいて...\"",
        "checked": true
    },
    {
        "en_raw": "Ah, that man living in the house full of books?",
        "en_clean": "Ah, that man living in the house full of books?",
        "jp_raw": "ああ、本がいっぱいの家に住んでる人？",
        "jp_clean": "ああ、本がいっぱいの家に住んでる人？",
        "checked": true
    },
    {
        "en_raw": "He seems to be really into that book series your Housemaiden likes... \"The Cursing of Château Castle\", right?",
        "en_clean": "He seems to be really into that book series your Housemaiden likes... \"The Cursing of Château Castle\", right?",
        "jp_raw": "彼も、侍祭君が好きなあのシリーズものにハマってるみたいだね... 「キャッスル城の呪い」だっけ？",
        "jp_clean": "彼も、侍祭君が好きなあのシリーズものにハマってるみたいだね... 「キャッスル城の呪い」だっけ？",
        "checked": true
    },
    {
        "en_raw": "Didn't the last issue come out right as the King's Curse started freezing Vaugarde in time? It might be hard to find...",
        "en_clean": "Didn't the last issue come out right as the King's Curse started freezing Vaugarde in time? It might be hard to find...",
        "jp_raw": "最新巻が出たのは、王の呪いがヴォーガルドの時間を止め始めてすぐの頃だね？ 最新巻を見つけるのは難しそうだ...",
        "jp_clean": "最新巻が出たのは、王の呪いがヴォーガルドの時間を止め始めてすぐの頃だね？ 最新巻を見つけるのは難しそうだ...",
        "checked": true
    },
    {
        "en_raw": "If you find any issues, you should remember the issue number and tell him! Maybe you might end up finding the very last one!",
        "en_clean": "If you find any issues, you should remember the issue number and tell him! Maybe you might end up finding the very last one!",
        "jp_raw": "シリーズの本を見つけたら、巻数を覚えておいて、彼に教えてあげなよ！ そのうち、最新巻を見つけられるかもしれない！",
        "jp_clean": "シリーズの本を見つけたら、巻数を覚えておいて、彼に教えてあげなよ！ そのうち、最新巻を見つけられるかもしれない！",
        "checked": true
    },
